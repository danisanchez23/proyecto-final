@page "/productos"
@inject NavigationManager navigationManager
@inject ListadoProductos.Servicios.Services.ProductoService productoService
@inject ListadoProductos.Services.AlertaServicio alertaService
@using ListadoProductos.Servicios.Modelos

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="mb-0">Listado de Productos</h3>
    <button class="btn btn-success" @onclick="nuevo">
        <i class="bi bi-plus-circle"></i>
        Agregar
    </button>
</div>

<div class="mb-3">
    <input type="text" class="form-control" placeholder="Buscar por nombre o categoría..."
           @bind="terminoBusqueda" @bind:after="buscar" />
</div>

<div style="background:#fff; border: 0.5px solid #B5D4F4; border-radius: 12px; overflow: hidden;">
    <table class="table table-striped mb-0">
        <thead style="background-color: #E6F1FB;">
            <tr>
                <th style="color: #378ADD; font-size: 11px; border-bottom: 0.5px solid #B5D4F4;">Id</th>
                <th style="color: #378ADD; font-size: 11px; border-bottom: 0.5px solid #B5D4F4;">Nombre</th>
                <th style="color: #378ADD; font-size: 11px; border-bottom: 0.5px solid #B5D4F4;">Descripción</th>
                <th style="color: #378ADD; font-size: 11px; border-bottom: 0.5px solid #B5D4F4;">Precio</th>
                <th style="color: #378ADD; font-size: 11px; border-bottom: 0.5px solid #B5D4F4;">Stock</th>
                <th style="color: #378ADD; font-size: 11px; border-bottom: 0.5px solid #B5D4F4;">Categoría</th>
                <th style="color: #378ADD; font-size: 11px; border-bottom: 0.5px solid #B5D4F4;">Fecha Ingreso</th>
                <th style="color: #378ADD; font-size: 11px; border-bottom: 0.5px solid #B5D4F4;">Opciones</th>
            </tr>
        </thead>
        <tbody>
            @if (lista.Count == 0)
            {
                <tr>
                    <td colspan="8" class="text-center" style="color: #85B7EB; padding: 32px;">
                        No hay productos registrados
                    </td>
                </tr>
            }
            else
            {
                @foreach (var fila in lista)
                {
                    <tr>
                        <td style="color: #85B7EB;">@fila.Id</td>
                        <td style="font-weight: 500; color: #042C53;">@fila.Nombre</td>
                        <td style="color: #378ADD;">@fila.Descripcion</td>
                        <td style="font-weight: 500; color: #0C447C;">@fila.Precio.ToString("C")</td>
                        <td style="color: #0C447C;">@fila.Stock</td>
                        <td>
                            <span style="background: #B5D4F4; color: #042C53; padding: 3px 10px; border-radius: 999px; font-size: 11px; font-weight: 500;">
                                @fila.Categoria
                            </span>
                        </td>
                        <td style="color: #85B7EB;">@fila.FechaIngreso.ToString("dd/MM/yyyy")</td>
                        <td>
                            <button @onclick="(() => editar(fila.Id))" class="btn btn-sm"
                                    style="background: #E6F1FB; border: 0.5px solid #85B7EB; color: #185FA5; margin-right: 4px;">
                                <i class="bi bi-pencil-square"></i>
                            </button>
                            <button @onclick="(() => eliminar(fila.Id))" class="btn btn-sm"
                                    style="background: #E6F1FB; border: 0.5px solid #85B7EB; color: #0C447C;">
                                <i class="bi bi-trash3-fill"></i>
                            </button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@code {
    public List<Producto> lista = new List<Producto>();
    public string terminoBusqueda { get; set; } = string.Empty;

    protected async override Task OnInitializedAsync()
    {
        productoService.OnChange += Actualizar;
        lista = await productoService.ListarProductos();
    }

    private async Task buscar()
    {
        lista = await productoService.Buscar(terminoBusqueda);
    }

    private async Task nuevo()
    {
        navigationManager.NavigateTo("/productos/nuevo");
    }

    private async Task editar(int id)
    {
        navigationManager.NavigateTo($"/productos/editar/{id}");
    }

    private async Task eliminar(int id)
    {
        bool confirmar = await alertaService.Confirmar("Eliminar", "¿Está seguro de que desea eliminar este producto?");
        if (confirmar)
        {
            await productoService.Eliminar(id);
            await alertaService.Informar("Éxito", "Producto eliminado correctamente.");
        }
    }

    private void Actualizar()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        productoService.OnChange -= Actualizar;
    }
}