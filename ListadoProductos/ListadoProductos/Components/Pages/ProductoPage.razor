@page "/productos"
@inject NavigationManager navigationManager
@inject ListadoProductos.Servicios.Services.ProductoService productoService
@inject ListadoProductos.Services.AlertaServicio alertaService
@using ListadoProductos.Servicios.Modelos

<h3>Listado de Productos</h3>

<div class="text-center mb-3">
    <button class="btn btn-success" @onclick="nuevo">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus-circle" viewBox="0 0 16 16">
            <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/>
            <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4"/>
        </svg>
        Nuevo
    </button>
</div>

<div class="mb-3">
    <input type="text" class="form-control" placeholder="Buscar por nombre o categoría..."
           @bind="terminoBusqueda" @bind:after="buscar" />
</div>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Id</th>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Precio</th>
            <th>Stock</th>
            <th>Categoría</th>
            <th>Fecha Ingreso</th>
            <th>Opciones</th>
        </tr>
    </thead>
    <tbody>
        @if (lista.Count == 0)
        {
            <tr>
                <td colspan="8" class="text-center">No hay productos registrados.</td>
            </tr>
        }
        else
        {
            @foreach (var fila in lista)
            {
                <tr>
                    <td>@fila.Id</td>
                    <td>@fila.Nombre</td>
                    <td>@fila.Descripcion</td>
                    <td>@fila.Precio.ToString("C")</td>
                    <td>@fila.Stock</td>
                    <td>@fila.Categoria</td>
                    <td>@fila.FechaIngreso.ToString("dd/MM/yyyy")</td>
                    <td>
                        <button @onclick="(() => editar(fila.Id))" class="btn btn-primary btn-sm">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pencil-square" viewBox="0 0 16 16">
                                <path d="M15.502 1.94a.5.5 0 0 1 0 .706L14.459 3.69l-2-2L13.502.646a.5.5 0 0 1 .707 0l1.293 1.293zm-1.75 2.456-2-2L4.939 9.21a.5.5 0 0 0-.121.196l-.805 2.414a.25.25 0 0 0 .316.316l2.414-.805a.5.5 0 0 0 .196-.12l6.813-6.814z"/>
                                <path fill-rule="evenodd" d="M1 13.5A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-6a.5.5 0 0 0-1 0v6a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-11a.5.5 0 0 1 .5-.5H9a.5.5 0 0 0 0-1H2.5A1.5 1.5 0 0 0 1 2.5z"/>
                            </svg>
                        </button>
                        <button @onclick="(() => eliminar(fila.Id))" class="btn btn-danger btn-sm">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash3-fill" viewBox="0 0 16 16">
                                <path d="M11 1.5v1h3.5a.5.5 0 0 1 0 1h-.538l-.853 10.66A2 2 0 0 1 11.115 16h-6.23a2 2 0 0 1-1.994-1.84L2.038 3.5H1.5a.5.5 0 0 1 0-1H5v-1A1.5 1.5 0 0 1 6.5 0h3A1.5 1.5 0 0 1 11 1.5m-5 0v1h4v-1a.5.5 0 0 0-.5-.5h-3a.5.5 0 0 0-.5.5M4.5 5.029l.5 8.5a.5.5 0 1 0 .998-.06l-.5-8.5a.5.5 0 1 0-.998.06m6.53-.528a.5.5 0 0 0-.528.47l-.5 8.5a.5.5 0 0 0 .998.058l.5-8.5a.5.5 0 0 0-.47-.528M8 4.5a.5.5 0 0 0-.5.5v8.5a.5.5 0 0 0 1 0V5a.5.5 0 0 0-.5-.5"/>
                            </svg>
                        </button>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

@code {
    public List<Producto> lista = new List<Producto>();
    public string terminoBusqueda { get; set; } = string.Empty;

    protected async override Task OnInitializedAsync()
    {
        productoService.OnChange += Actualizar;
        lista = await productoService.ListarProductos();
    }

    private async Task buscar()
    {
        lista = await productoService.Buscar(terminoBusqueda);
    }

    private async Task nuevo()
    {
        navigationManager.NavigateTo("/productos/nuevo");
    }

    private async Task editar(int id)
    {
        navigationManager.NavigateTo($"/productos/editar/{id}");
    }

    private async Task eliminar(int id)
    {
        bool confirmar = await alertaService.Confirmar("Eliminar", "¿Está seguro de que desea eliminar este producto?");
        if (confirmar)
        {
            await productoService.Eliminar(id);
            await alertaService.Informar("Éxito", "Producto eliminado correctamente.");
        }
    }

    private void Actualizar()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        productoService.OnChange -= Actualizar;
    }
}
